{
  "name": "ggcheckout-mcp-monorepo",
  "version": "1.0.0",
  "description": "GG Checkout MCP and n8n node monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "publish:mcp": "npm publish --workspace=packages/mcp",
    "publish:n8n": "npm publish --workspace=packages/n8n-node"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.7.1"
  },
  "keywords": [
    "mcp",
    "n8n",
    "ggcheckout",
    "monorepo"
  ],
  "author": "GG Checkout Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gui-drumond/ggcheckout-mcp.git"
  }
}
