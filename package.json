{
  "name": "ggcheckout-mcp",
  "version": "0.6.0",
  "description": "MCP server for GG Checkout - Manage your products via AI agents",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "type": "module",
  "bin": {
    "ggcheckout-mcp": "dist/index.js"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run build -w ui && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest run && npm test -w ui",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "pretest": "npm run build -w ui"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ggcheckout",
    "ai",
    "automation",
    "api",
    "claude",
    "anthropic",
    "checkout",
    "payments",
    "ecommerce",
    "brazilian",
    "pix",
    "infoproduct"
  ],
  "author": "GG Checkout Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggCheckout/ggcheckout-mcp.git"
  },
  "homepage": "https://docs.ggcheckout.com/help/vendedor/ferramentas-avancadas/mcp",
  "bugs": {
    "url": "https://github.com/ggCheckout/ggcheckout-mcp/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "axios": "^1.14.0",
    "dotenv": "^17.2.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.7.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "mcpName": "io.github.ggCheckout/ggcheckout-mcp",
  "workspaces": [
    "ui"
  ]
}
