# API Key from GG Checkout Dashboard
# Get your API key at: https://www.ggcheckout.com/
GGCHECKOUT_API_KEY=ggck_live_your_api_key_here
# Or the WhatsApp assistant key (ggck_agent_ + 64 hex): then only the agent tools are registered.
# GGCHECKOUT_API_KEY=ggck_agent_your_assistant_key_here
# Required with that key: the one conversation this run answers (phone digits with country code, or lid:...).
# GGCHECKOUT_AGENT_CONTACT=553199998888

# Optional: enables the payments API tools (PIX charges). ggpk_test_ = simulated, ggpk_live_ = real.
# GG_PAYMENTS_API_KEY=ggpk_test_your_key_here
# GG_PAYMENTS_API_URL=https://api.ggcheckout.app/v1
